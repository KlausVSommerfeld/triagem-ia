# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env preenchido — ele já está no .gitignore.

# String de conexão com o banco (Postgres recomendado). Ainda não há
# camada de persistência implementada neste protótipo.
DATABASE_URL=postgresql://user:password@localhost:5432/triagem_ia

# Credenciais OAuth do provedor de rede social (Meta, etc.). Obtidas no
# painel de desenvolvedor da plataforma, após aprovação do app review
# para escopos de dados sensíveis/saúde. Ainda não implementado — ver
# ingestion/social_connector.py.
SOCIAL_OAUTH_CLIENT_ID=
SOCIAL_OAUTH_CLIENT_SECRET=

# Chave de criptografia para dados em repouso. Gere com, por exemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Ainda não há decisão de onde/como será usada.
ENCRYPTION_KEY=
